{
  "name": "@kaashi/server",
  "version": "0.0.0",
  "private": true,
  "description": "Kaashi backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@kaashi/source src/index.ts",
