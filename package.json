{
  "name": "kaashi",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-driven low-code platform",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,green \"npm run dev -w @kaashi/server\" \"npm run dev -w @kaashi/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @kaashi/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
